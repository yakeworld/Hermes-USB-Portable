# Synthos Docker — Environment Variables
# Copy to .env and fill in your API keys

# REQUIRED: Primary LLM provider
# Get your DeepSeek API key from https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-xxx

# RECOMMENDED: Academic paper search
# Semantic Scholar API key (free: https://api.semanticscholar.org/)
SEMANTIC_SCHOLAR_API_KEY=

# OPTIONAL: Fallback LLM providers
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# OPTIONAL: Additional search APIs
PUBMED_API_KEY=
OPENALEX_API_KEY=
